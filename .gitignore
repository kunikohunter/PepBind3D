*.pyc
.ipynb_checkpoints/
CLAUDE.md
.claude/

# --- Revision material: reviews, plan, manuscript drafts, response letter ---
# Private to the revision; never goes in the public code repo.
revisions/
# ...except the revision tooling itself, which is code and must not be lost.
# Manuscripts, reviews, the plan and the response letter stay ignored.
!revisions/
revisions/*
!revisions/*.py
# kept as a safety net in case these are re-dropped at the repo root
REVISION_PLAN.md
PepBind3D_072026_Submitted.docx
Reviews.docx
*.docx
# --- Structure data: belongs in the HuggingFace dataset, never in git ---
*.pdb
*.cif
*.silent
*.silent.bak
*.sc

# --- Rosetta run trees (tens of GB, regenerable) ---
benchmark/rosetta_arm/arm/
benchmark/rosetta_arm/pilot/
benchmark/refs/cif/
benchmark/af2_msa/msa_cache/
benchmark/wrappers/test_*/
hlac_production/
hlac/

# --- AlphaFold2 / model intermediates ---
*.pkl
*.npz
msas/
features.pkl
result_*.pkl
ranked_*.pdb

# --- Cluster logs and job artifacts ---
logs/
*.out
*.err
*.log
slurm-*.out
ROSETTA_CRASH.log

# --- Generated job/target lists (rebuilt by build_arm.py) ---
arm_joblist.txt
arm_skipped.csv
dock_tasklist.txt

# --- Revision/manuscript material (public repo) ---
paper_corrections.md

# --- Local agent/session state ---
.loops-mem/
scratchpad/
.DS_Store

# --- Working notes, task prompts, discovery/inventory dumps (never public) ---
notes/

# Regeneration run records are deliberately tracked as provenance
!regeneration/*.out

# Companion run trees, symlinked here for grouping only. These point at
# hundreds of GB and over a million files; git must never walk them.
run/

# Per-prediction fold output from analysis/affinity_baseline.py: 88k rows,
